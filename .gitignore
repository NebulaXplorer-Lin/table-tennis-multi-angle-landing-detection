*.partial

# Event experiments: keep lightweight records, exclude working image caches.
ttnet/runs/*/pilot/
ttnet/runs/*/evaluations/*/images/
ttnet/runs/*/evaluations/*/*/images/
ttnet/runs/*/label_audit.jpg
ttnet/runs/*/training_curve.png
ttnet/runs/*/*_review.jpg
ttnet/runs/*/analysis/*.jpg

# 逐帧预测与中间结果；保留配置、指标、摘要和错误索引。
/ttnet/runs/*/evaluations/**/*_frames.jsonl
/ttnet/runs/*/evaluations/**/*_localizations.jsonl
/ttnet/runs/*/evaluations/**/*_complete_predictions.jsonl
/ttnet/runs/*/evaluations/**/*_unscored_events.jsonl
/ttnet/runs/*/evaluations/**/*_events_without_coordinates.jsonl
/ttnet/runs/*/evaluations/**/predictions.jsonl

# experiments/ stores lightweight, reviewable records; weights and media are
# excluded above, and working artifacts belong in out/.

# Training recipes are source code, even though their directory names match
# the broad data/experiment exclusions above.
!/configs/datasets/
!/configs/datasets/**
!/configs/experiments/
!/configs/experiments/**
